# Copy this file to .env and adjust values for your machine.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/gym_system/v2
APP_TIMEZONE=UTC
APP_KEY=change-this-to-a-random-64-character-secret
SESSION_NAME=gym_v2_session
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gym_system_v2
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_CONNECT_TIMEOUT=5
